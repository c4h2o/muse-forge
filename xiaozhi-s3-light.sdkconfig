# xiaozhi ESP32-S3 N16R8 — Muse board config (Light build)
#
# Stage 0/1: Light build (status LED + one button), no display and no audio.
# Goal: prove it compiles, flashes, pairs, and reaches a self-hosted
# muse-forge server.
#
# Usage:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;devices/sdkconfig.xiaozhi-s3-light" build
#
# Upstream facts checked against muse-gadget-sdk @ 693cde9:
#   - 16 MB boards use partitions_muse.csv (devices/AGENTS.md:75)
#   - CONFIG_HOMEHUB_BUTTON_GPIO=0 is upstream practice -- ideaspark,
#     espressif-box-3, cardputer-adv and home-assistant-voice all set it
#   - that button is active low with an internal pull-up
#     (devices/AGENTS.md:100)
#
# Hardware (from the schematics, a stacked pair):
#   Bottom: ESP32-S3-WROOM-1-N16R8 (16 MB flash / 8 MB PSRAM), I2C RGB LED
#           (XL-4009 on SCL=GPIO8 / SDA=GPIO9), BOOT on GPIO0, RST to EN,
#           CH343P USB-serial, XL6009 boost converter, passive buzzer,
#           USB-OTG on GPIO19/20
#   Top:    240x240 ST7789 (CS=10 BLK=11 SCL1=12 SDA1=13 RES=14),
#           INMP441 (WS=4 SCK=5 SD=6), MAX98357A (DIN=7 BCLK=15 LRC=16),
#           three app keys: volume+ = 39, volume- = 40, wake = 0
#
#   GPIO conflicts: none. GPIO0 is the only overlap between the two boards,
#   and it is the same physical key -- the bottom board's BOOT switch and the
#   top board's wake button share one pad. This build only uses GPIO0 and
#   touches neither the display, the audio nor the LED, so both boards work.

# ---- Target and flash ------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- Partition table -------------------------------------------------------
# sdkconfig.defaults points at partitions.csv, which ends at 0x422000
# (4.13 MB) in the 8 MB layout. On a 16 MB board that is harmless -- a
# partition table only carves out what it needs and the remaining 11.9 MB
# just sits unallocated. The official 16 MB Light boards (ideaspark,
# home-assistant-voice) do exactly this.
#
# The cost is 2 MB OTA slots instead of 4 MB. To use the full 16 MB,
# uncomment the line below.
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse.csv"
#
# WARNING: switching partition tables is a re-flash boundary. Firmware
# flashed with the old table cannot OTA across the change, and prod_data /
# prod_bak sit at fixed offsets (0x420000 / 0x421000) written during
# manufacturing. Decide before the first flash, then leave it alone.

# ---- PSRAM (the "R8" in N16R8 means 8 MB) ---------------------------------
# Octal mode at 80 MHz, matching the aipi board. ESP32-S3 PSRAM parts are
# usually octal-packaged.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Upstream sdkconfig.defaults notes an intermittent PSRAM memtest failure on
# first boot (3/262144), so the test is skipped. Same as the other boards.
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set

# ---- Bluetooth allocations in PSRAM ---------------------------------------
# NimBLE is steadier with 8 MB of PSRAM available.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ---- Button ---------------------------------------------------------------
# GPIO0 is the wake button, which is also BOOT. Four official boards set 0.
#
# Caveat: do not hold this button while powering on or pressing RESET, or
# the ESP32-S3 enters download mode -- GPIO0 is a strapping pin. Pressing it
# while the firmware is running is harmless.
CONFIG_HOMEHUB_BUTTON_GPIO=0

# ---- Status LED -----------------------------------------------------------
# Neither upstream backend fits this board.
#
# The rainbow LED is an I2C RGB part: silkscreen "1080A / TYPE-C 3.5M RGBP",
# part XL-4009-I2C (alternatives: XL-4009-0/1/2/128/RGB/CT1). It sits on
# SCL=GPIO8 / SDA=GPIO9, and D1/D2/D3 are I2C register writes rather than
# three separate PWM channels.
#
# So the two available backends both mismatch:
#   PWM_RGB       -> three LEDC PWM channels on pins hardcoded in
#                     main/led_status.c:63-68 (24/25/26 on production boards,
#                     2/3/6 on DVT). These are compile-time macros, not
#                     Kconfig symbols, so an overlay cannot change them.
#   DEVKIT_GPIO27 -> single-wire addressable (WS2812-style). Wrong protocol.
#
# Three options:
#
# A (recommended, least work): keep NONE below. The serial log reports the
#   same state machine either way, so nothing is lost during bring-up.
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
#
# B: add an I2C RGB backend to the firmware -- a new backend in
#   main/led_status.c that writes the XL-4009 PWM registers. About half a
#   day. (Needs a new Kconfig option and code; this repo has neither yet.)

# ---- Memory and network ---------------------------------------------------
# Consistent with sdkconfig.defaults: put mbedTLS allocations and the Wi-Fi
# buffers in PSRAM. 16 MB flash plus 8 MB PSRAM is the roomy configuration.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Sleep ----------------------------------------------------------------
# Tickless helps with no display and no audio. The Light build is about
# proving the path works, not about battery life.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
